# Database Configuration
# For local development, use a PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/database_name
# For production (Vercel), this will be automatically provided
DATABASE_URL=postgresql://user:password@localhost:5432/your_database_name

# Server Configuration
PORT=3001

# Optional: News API Key
# Get a free API key from https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Optional: Cron Secret
# Generate with: openssl rand -base64 32
# Used for securing cron endpoints in production
CRON_SECRET=your_random_secret_token_here

# Environment
# Set to 'development' for local dev, 'production' for production
NODE_ENV=development
